# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# Dataset and generated artifacts — never commit these (keep the empty dirs)
data/*
!data/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Video files must never enter git history (DAiSEE license + repo size)
*.avi
*.mp4
*.mkv
*.webm
*.y4m
# NOTE: the parity fixture clip (ml/tests/fixtures/parity_clip.mp4) is
# DAiSEE-derived and stays OUT of git per the dataset license — share it
# with Track B directly. parity_expected.json (derived features) IS tracked.
# The PNG frames dumped from that same clip (ml/tests/fixtures/parity_frames/)
# carry the same DAiSEE-license restriction and stay out of git too.
ml/tests/fixtures/parity_frames/
# Phase 1.3 demo-hardening scenario videos (DAiSEE-derived fake-webcam
# inputs) — same restriction; see docs/demo-failure-modes.md for the
# recorded observations instead of the source clips.
ml/tests/fixtures/failure_modes/

# MediaPipe model asset — downloaded, not committed (see README)
*.task

# Model binaries: only the shipped web model is tracked
*.onnx
!web/public/model/*.onnx
*.pt
*.pth

# Web (Track B)
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
# generated by `npm run assets` (copy-assets.mjs)
web/public/mediapipe/
web/public/ort/
# MediaPipe model asset staged for the app + J1 gate — downloaded, not
# committed (see README); *.task above also covers this, listed for clarity
web/public/models/face_landmarker.task

# contains a DAiSEE participant's face - do not redistribute (license);
# retake with your own face for the thesis
docs/results/app_screenshot.png

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/

# git format-patch exports — transient, never part of the tree
*.patch

# Local archive of historical tracking documents — never commit
archive/
